{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/summary",
      "destination": "/data/summary.json"
    },
    {
      "source": "/api/health",
      "destination": "/data/health.json"
    },
    {
      "source": "/api/cases",
      "destination": "/data/cases.json"
    },
    {
      "source": "/api/cases/:caseId",
      "destination": "/data/cases/:caseId.json"
    },
    {
      "source": "/api/export.csv",
      "destination": "/data/output.csv"
    },
    {
      "source": "/api/evidence/:evidenceId",
      "destination": "/data/evidence/:evidenceId"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; connect-src 'self'; script-src 'self'; style-src 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/export.csv",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"output.csv\""
        }
      ]
    },
    {
      "source": "/api/evidence/:evidenceId",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ]
}
